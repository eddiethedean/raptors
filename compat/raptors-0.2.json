  },
  "api": {
    "module": "raptors",
    "scalar_results": {
      "representation": "typed Raptors scalar wrappers",
      "supported_behavior": ["dtype inspection", "comparison", "bool conversion", "int/float/complex conversion where implemented", "reuse as array and assignment values"],
      "known_limits": ["not NumPy scalar classes", "no full scalar arithmetic or protocol compatibility"]
    },
    "array_function": {
      "status": "partial",
      "signature": "array(data, dtype=None, copy=True, order='K')",
      "implemented_behavior": [
        "Numeric inference from Python bool, int, float, and complex values",
        "Rectangular list and tuple inputs, including zero-dimensional and empty arrays",
        "Explicit numeric dtype names, aliases, and built-in Python numeric type objects",
        "Raptors arrays and supported Raptors scalar wrappers as input",
        "C and F output order; K and A order selection for Raptors array inputs",
        "copy=False reuses only a compatible Raptors array and errors when copying is required"
      ],
      "known_limits": [
        "Ragged, object, string, structured, datetime, and foreign-buffer inputs are unsupported",
        "copy=False cannot reuse non-Raptors inputs",
        "Input conversion protocols such as __array__ and the buffer protocol are unsupported"
      ]
    },
    "zeros_function": {
      "status": "partial",
      "signature": "zeros(shape, dtype=None, order='C')",
      "implemented_behavior": ["Numeric dtype allocation", "C and F memory order", "Zero-dimensional and zero-size shapes"],
      "known_limits": ["Only C and F order are accepted"]
    },
    "empty_function": {
      "status": "partial",
      "signature": "empty(shape, dtype=None, order='C')",
      "implemented_behavior": ["Numeric dtype allocation", "C and F memory order", "Zero-dimensional and zero-size shapes"],
      "known_limits": ["Storage is initialized for Rust safety; returned element values are unspecified", "Only C and F order are accepted"]
    },
    "promote_types_function": {
      "status": "partial",
      "signature": "promote_types(left, right)",
      "implemented_behavior": ["NumPy 2.5.3 dtype promotion for all pairs in the declared numeric dtype set"],
      "known_limits": ["This function does not implement scalar arithmetic or ufunc promotion"]
    },
    "dtype_metadata": ["name", "kind", "char", "itemsize", "alignment", "byteorder", "isnative", "str", "type", "newbyteorder"],
    "array_metadata": ["shape", "ndim", "size", "strides", "itemsize", "nbytes", "dtype", "c_contiguous", "f_contiguous", "writeable", "flags"],
    "array_methods": ["reshape", "transpose", "T", "astype", "copy"],
    "indexing": ["integer", "slice", "tuple", "ellipsis", "new axis", "boolean scalar", "boolean mask", "integer fancy arrays", "mixed basic and advanced indices"],
    "assignment": ["scalar casts", "sequence casts", "broadcasted assignment", "boolean-mask assignment", "fancy-index assignment", "duplicate-index writes", "overlap snapshot"]
  },
  "unsupported": [
    "Arithmetic operators, ufuncs, and reductions",
    "datetime64 and timedelta64",
    "object, bytes string, Unicode string, void, structured, subarray, and StringDType arrays",
    "Decimal and arbitrary user-defined scalar conversion",
    "Foreign memory, buffer protocol, DLPack, and NumPy interoperation",
    "Full NumPy scalar identity and scalar protocol behavior",
    "NumPy C ABI compatibility",
    "Free-threaded CPython"
  ],
  "known_gaps": [
    "The public input domain is Python bool/int/float/complex values, rectangular lists/tuples, and Raptors arrays/scalars; arbitrary third-party scalar protocols are not implemented",
    "Extended precision follows the target NumPy platform representation; Apple ARM64 and Windows use the same storage precision as float64/complex128 while retaining longdouble/clongdouble dtype codes and wrappers",
    "The declared API is a numeric foundation only; methods and behaviors not listed in this contract remain unsupported"
  ],
